# =============================================================================
# ETSY AI AUTOPILOT — environment configuration
# Copy this file to `.env` in the repo root (and/or per-app `.env` files,
# see docs/ETSY_SETUP.md) and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- Core infrastructure -----------------------------------------------------
NODE_ENV=development
# Postgres connection string used by Prisma (packages/database)
DATABASE_URL=postgresql://etsy_autopilot:changeme@localhost:5432/etsy_autopilot
# Redis connection string used by BullMQ (apps/worker) and API rate limiting
REDIS_URL=redis://localhost:6379

# --- App URLs -----------------------------------------------------------------
API_BASE_URL=http://localhost:4000
DASHBOARD_BASE_URL=http://localhost:3000
# Read by apps/dashboard (Next.js) in the browser — must be NEXT_PUBLIC_ to be exposed client-side.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Public URL Etsy will redirect back to after OAuth consent. Must be HTTPS in
# production and must exactly match the callback URL registered in the Etsy
# Developer app settings. See docs/ETSY_SETUP.md.
ETSY_OAUTH_REDIRECT_URI=http://localhost:4000/api/etsy/oauth/callback
# Public URL Etsy will POST webhook events to in production.
ETSY_WEBHOOK_URL=http://localhost:4000/api/etsy/webhooks

# --- Brand -----------------------------------------------------------------
# Customer-facing brand name — printed on product files, PDFs, the license,
# and mentioned in listing copy. Deliberately separate from the shop's
# registered Etsy account name (e.g. a technical handle like
# "FormAndFernCo"), which is never shown to customers.
BRAND_DISPLAY_NAME=Form & Fern

# --- Etsy Open API v3 (https://developer.etsy.com) ----------------------------
# Created in the Etsy Developer Portal after you (the human) register an app.
# See docs/ETSY_SETUP.md for the exact click-by-click steps.
ETSY_API_KEYSTRING=
ETSY_SHARED_SECRET=
# The numeric shop_id of your live Etsy shop. Filled in after you connect via
# the dashboard OAuth flow (the app also discovers and stores this itself).
ETSY_SHOP_ID=
# Comma-separated OAuth scopes requested during authorization.
ETSY_OAUTH_SCOPES=listings_r,listings_w,listings_d,shops_r,shops_w,transactions_r,transactions_w,profile_r
# From the Etsy Developer Portal's Webhook portal, per endpoint (starts with
# "whsec_"). Only needed once you've set up a webhook endpoint — see
# docs/ETSY_SETUP.md. Order-event webhooks are optional; the system also
# polls shop receipts as a reliable fallback.
ETSY_WEBHOOK_SIGNING_SECRET=
# Optional FX rates for publishing to a shop whose currency isn't USD (all
# internal pricing config is USD-denominated). JSON object, currency code ->
# rate relative to USD, e.g. {"EUR":0.92,"GBP":0.79}. Leave empty to
# hard-block publishing to non-USD shops rather than silently mis-pricing
# listings — see packages/core/src/currency.ts.
FX_STATIC_RATES=

# --- Secrets encryption ---------------------------------------------------
# 32-byte (base64) key used to encrypt OAuth tokens and other secrets at rest
# in the database. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# --- Auth (single-owner admin dashboard) --------------------------------------
# Generate with: openssl rand -base64 48
SESSION_SECRET=
ADMIN_EMAIL=you@example.com
# bcrypt hash of your admin password. Generate via `pnpm --filter @etsymagazam/api run hash-password -- "your-password"`
ADMIN_PASSWORD_HASH=

# --- AI providers (abstraction layer picks whichever is configured) -----------
# At least one text provider and one image provider is required for the
# autopilot to run for real. Everything works in adapter/mock mode without
# these for local development and DRY_RUN pipelines.
AI_TEXT_PROVIDER=openai
AI_IMAGE_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
# Cheap/expensive model routing (see packages/ai). Override per environment.
AI_TEXT_MODEL_CHEAP=gpt-4o-mini
AI_TEXT_MODEL_PREMIUM=gpt-4o
AI_IMAGE_MODEL=gpt-image-1
GEMINI_TEXT_MODEL=gemini-1.5-flash
GEMINI_IMAGE_MODEL=imagen-3.0-generate-001

# --- Trend research data sources ----------------------------------------------
# Google Trends has no official free API; if you have access to a licensed
# provider (e.g. SerpApi Google Trends endpoint) put its key here. Otherwise
# Trend Scout falls back to manual CSV/keyword input via the dashboard.
SERPAPI_API_KEY=
PINTEREST_API_KEY=

# --- Autopilot behavior controls ----------------------------------------------
AUTO_PUBLISH=false
DRY_RUN=true
MAX_PRODUCTS_PER_DAY=3
MAX_PRODUCTS_PER_WEEK=10
QA_MIN_SCORE=90
QA_MAX_RETRIES=2
IP_RISK_REJECT_THRESHOLD=40
MIN_PRICE=3.00
MAX_PRICE=45.00
MAX_DAILY_PRICE_CHANGE=1

# --- Alerting -------------------------------------------------------------
# Optional: alerts (P0/P1/P2) can also be delivered via email/Slack/webhook.
ALERT_EMAIL_TO=
ALERT_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Storage --------------------------------------------------------------
# Local filesystem path (default) or S3-compatible bucket for generated
# product files, mockups and listing images.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# --- Observability --------------------------------------------------------
LOG_LEVEL=info
